# Copy this file to .env and replace the placeholder values.
# Never commit .env or paste API keys into source files, logs, or reports.

# Required for scenario generation (OpenAI).
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# Required only if TARGET_PROVIDER=anthropic.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Model used by scenario_generator.py to draft synthetic evaluation scenarios.
# Draft scoring criteria remain pending_review until a human approves them.
SCENARIO_MODEL=gpt-4o

# Target agent evaluated by agent_runner.py.
# Supported providers: openai | anthropic
TARGET_PROVIDER=openai
TARGET_MODEL=gpt-4o

# Optional operational settings used by API-calling modules.
# Names are standardized: API_TIMEOUT_SECONDS and API_MAX_RETRIES.
API_TIMEOUT_SECONDS=60
API_MAX_RETRIES=3
